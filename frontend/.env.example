NODE_ENV=development

# Frontend public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API URL (browser)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Backend API URL (server-side/internal, e.g. Docker)
BACKEND_INTERNAL_URL=http://backend:4000

# Session secret used by frontend auth cookie verification
SESSION_SECRET=change-this-in-production

# Umami analytics (optional overrides; defaults are set in UmamiAnalytics)
NEXT_PUBLIC_UMAMI_HOST=https://analytics.krftlabs.com
NEXT_PUBLIC_UMAMI_WEBSITE_ID=55d984f1-bcef-4a22-a268-967d304c73c9

# Optional legacy fallbacks
NEXTAUTH_SECRET=change-this-in-production
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
ENABLE_LOGGING=true
