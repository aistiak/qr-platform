NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb://admin:adminpassword@localhost:27017/qr-platform?authSource=admin

# Frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# Session signing secret
SESSION_SECRET=change-this-in-production

# Google OAuth (optional)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Optional fallbacks
APP_URL=http://localhost:4000
PUBLIC_APP_URL=http://localhost:3000
IMAGE_UPLOAD_DIR=./public/images
ENABLE_LOGGING=true

# Bugsink error tracking (Sentry-compatible; optional override)
BUGSINK_DSN=https://87f465a1cf7d4c189f4babe0216f46cd@bug.krftlabs.com/2
